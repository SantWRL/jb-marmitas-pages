# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase
# (Dashboard > Project Settings > API)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Opcional: só para testar o fluxo de pedidos fora do horário (11h-14h).
# Válido apenas no npm run dev (não afeta builds de produção). Deixe vazio
# ou remova no dia a dia.
# VITE_FORCE_OPEN=true
